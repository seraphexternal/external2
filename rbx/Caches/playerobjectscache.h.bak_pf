#pragma once
#include <unordered_map>
#include <unordered_set>
#include <cstdint>

// Last successfully read progression per player instance, keyed by address.
// CustomLeaderstats is not reliably resident, so a frame that fails to read it
// reuses the previous value instead of blanking the ESP.
struct ProgressionCacheEntry
{
    std::int64_t Level = -1;
    std::int64_t Elo = -1;
    bool LevelResolved = false;
    bool RankResolved = false;
};

inline std::unordered_map<uintptr_t, ProgressionCacheEntry>& ProgressionCache()
{
    static std::unordered_map<uintptr_t, ProgressionCacheEntry> cache;
    return cache;
}

inline void PruneProgressionCache(const std::unordered_set<uintptr_t>& live)
{
    auto& cache = ProgressionCache();
    for (auto it = cache.begin(); it != cache.end();)
    {
        if (live.count(it->first) == 0)
            it = cache.erase(it);
        else
            ++it;
    }
}
#include <thread>
#include <functional>
#include <cmath>
#include "../globals/options.h"
#include "../../rbx/globals/globals.h"
#include "../../features/pf_diag.h"

inline void CachePlayerObjects()
{
	std::vector<RobloxPlayer> tempList;

	while (Globals::running)
	{
		tempList.clear();

		if (Globals::Caches::CachedPlayers.empty())
		{
			// Sleep in small increments to allow instant response to forceRefresh
			for (int i = 0; i < 5 && Globals::running; i++)
			{
				if (Globals::Caches::forceRefresh)
					break;
				std::this_thread::sleep_for(std::chrono::milliseconds(100));
			}
			continue;
		}

if (Globals::Roblox::isPhantomForces)
		{
			Vectors::Vector3 camPos{0, 0, 0};
			uintptr_t cam = Globals::Roblox::Workspace.address
				? Memory->read<uintptr_t>(Globals::Roblox::Workspace.address + Offsets::Workspace::CurrentCamera) : 0;
			if (cam)
				camPos = Memory->read<Vectors::Vector3>(cam + Offsets::Camera::Position);

			auto pff = Globals::Roblox::Workspace.FindFirstChild("Players");

// PF anchor system: match anchors to Player objects directly for reliable team detection
struct AnchorEntry { RobloxInstance part; Vectors::Vector3 pos; int teamColor; };
std::vector<AnchorEntry> anchors;

if (pff.address)
{
    auto teamFolders = pff.GetChildren();
    for (auto& folder : teamFolders)
    {
        if (folder.Class() != "Folder") continue;
        
        for (auto& pl : folder.GetChildren())
        {
            if (pl.Class() != "Player") continue;
            
            // Get player's TeamColor directly from Player object
            int playerTeamColor = 0;
            if (pl.address)
                playerTeamColor = Memory->read<int>(pl.address + Offsets::Player::TeamColor);
            
            // Skip invalid team colors
            if (playerTeamColor == 0 || playerTeamColor == 194 || playerTeamColor == 0xFFFF)
                continue;
            
            // Get player's character model
            RobloxInstance character = pl.Character();
            if (!character.address) continue;
            
            // Find gun parts (anchors) in the character - search recursively
            std::function<void(const RobloxInstance&)> searchGunParts = [&](const RobloxInstance& node)
            {
                std::string cl = node.Class();
                if (cl == "Part" || cl == "MeshPart")
                {
                    std::string partName = node.Name();
                    bool isLikelyGun = false;
                    
                    // Check parent chain for Tool/Accessory (up to 5 levels)
                    RobloxInstance parent = node;
                    for (int depth = 0; depth < 8 && parent.address; ++depth)
                    {
                        uintptr_t parentAddr = Memory->read<uintptr_t>(parent.address + Offsets::Instance::Parent);
                        if (!parentAddr) break;
                        parent = RobloxInstance(parentAddr);
                        std::string pClass = parent.Class();
                        if (pClass == "Tool" || pClass == "Accessory" || pClass == "Model")
                        {
                            isLikelyGun = true;
                            break;
                        }
                    }
                    
                    // Also check part name for gun keywords
                    if (!isLikelyGun)
                    {
                        std::string lowerName = partName;
                        std::transform(lowerName.begin(), lowerName.end(), lowerName.begin(), ::tolower);
                        if (lowerName.find("gun") != std::string::npos ||
                            lowerName.find("rifle") != std::string::npos ||
                            lowerName.find("pistol") != std::string::npos ||
                            lowerName.find("shotgun") != std::string::npos ||
                            lowerName.find("sniper") != std::string::npos ||
                            lowerName.find("handle") != std::string::npos ||
                            lowerName.find("barrel") != std::string::npos ||
                            lowerName.find("body") != std::string::npos ||
                            lowerName.find("mesh") != std::string::npos)
                        {
                            isLikelyGun = true;
                        }
                    }
                    
                    // In PF, almost all Parts/MeshParts in character are gun parts
                    // Be permissive: if it's in character and not an obvious body part, it's likely a gun
                    std::string lowerName2 = partName;
                    std::transform(lowerName2.begin(), lowerName2.end(), lowerName2.begin(), ::tolower);
                    if (lowerName2.find("head") == std::string::npos &&
                        lowerName2.find("torso") == std::string::npos &&
                        lowerName2.find("torso") == std::string::npos &&
                        lowerName2.find("humanoid") == std::string::npos &&
                        lowerName2.find("root") == std::string::npos &&
                        lowerName2.find("arm") == std::string::npos &&
                        lowerName2.find("leg") == std::string::npos &&
                        lowerName2.find("foot") == std::string::npos &&
                        lowerName2.find("hand") == std::string::npos)
                    {
                        // If it's not an obvious body part, treat as potential gun
                        isLikelyGun = true;
                    }
                    
                    if (isLikelyGun)
                    {
                        Vectors::Vector3 pos = node.Position();
                        AnchorEntry ae;
                        ae.part = node;
                        ae.pos = pos;
                        ae.teamColor = playerTeamColor & 0xFFFF;
                        anchors.push_back(ae);
                    }
                }
                
                // Recurse into children
                for (auto& child : node.GetChildren())
                {
                    searchGunParts(child);
                }
            };
            
            searchGunParts(character);
        }
    }
}

// Build character lookup: use Player.Character() directly for each player in PF
struct CharEntry { RobloxInstance model; Vectors::Vector3 headPos; };
std::vector<CharEntry> characters;

if (pff.address)
{
    auto teamFolders = pff.GetChildren();
    for (auto& folder : teamFolders)
    {
        if (folder.Class() != "Folder") continue;
        for (auto& pl : folder.GetChildren())
        {
            if (pl.Class() != "Player") continue;
            RobloxInstance character = pl.Character();
            if (character.address && character.Class() == "Model")
            {
                RobloxInstance head = character.FindFirstChild("Head");
                if (!head.address)
                {
                    RobloxInstance hrp = character.FindFirstChild("HumanoidRootPart");
                    if (!hrp.address) hrp = character.FindFirstChild("Torso");
                    if (!hrp.address) hrp = character.FindFirstChild("UpperTorso");
                    if (hrp.address)
                    {
                        CharEntry ce;
                        ce.model = character;
                        ce.headPos = hrp.Position();
                        characters.push_back(ce);
                    }
                }
                else
                {
                    CharEntry ce;
                    ce.model = character;
                    ce.headPos = head.Position();
                    characters.push_back(ce);
                }
            }
        }
    }
}

PFDiag::Write("[PFDIAG] Characters found: " + std::to_string(characters.size()));
for (size_t ci = 0; ci < characters.size(); ++ci)
{
    PFDiag::Write("[PFDIAG] Char " + std::to_string(ci) + ": headPos=(" + 
        std::to_string((int)characters[ci].headPos.x) + "," + 
        std::to_string((int)characters[ci].headPos.y) + "," + 
        std::to_string((int)characters[ci].headPos.z) + ")");
}

PFDiag::Write("[PFDIAG] Anchors found: " + std::to_string(anchors.size()));
for (size_t ai = 0; ai < anchors.size(); ++ai)
{
    PFDiag::Write("[PFDIAG] Anchor " + std::to_string(ai) + ": " + anchors[ai].part.Name() + " pos=(" + 
        std::to_string((int)anchors[ai].pos.x) + "," + std::to_string((int)anchors[ai].pos.y) + "," + std::to_string((int)anchors[ai].pos.z) + 
        ") teamColor=" + std::to_string(anchors[ai].teamColor));
}

			static int s_pfPrevRoots = 0;
			static int s_pfSpawnFrames = 0;
			bool pfJustSpawned = (s_pfPrevRoots < 4 && (int)anchors.size() >= 8);
			if (pfJustSpawned)
				s_pfSpawnFrames = 200;
			else if (s_pfSpawnFrames > 0)
				s_pfSpawnFrames--;
			s_pfPrevRoots = (int)anchors.size();

// No myFolder detection needed - we use actual TeamColor from Player objects

for (auto& ae : anchors)
		{
			RobloxPlayer p;
			p.address = ae.part.address;
			p.Name = "";
			p.Team = RobloxInstance(0);
			p.TeamBrickColor = 0;
			p.TeamName = "";
			p.Character = ae.part;
			p.Humanoid = ae.part;
			p.HumanoidRootPart = ae.part;
			p.Head = ae.part;
			p.UseAnchor = true;
			p.AnchorPos = ae.pos;
			p.Health = 100.f;
			p.MaxHealth = 100.f;

			PFDiag::Write("[PFDIAG] Anchor: " + ae.part.Name() + " pos=(" + 
				std::to_string((int)ae.pos.x) + "," + std::to_string((int)ae.pos.y) + "," + std::to_string((int)ae.pos.z) + 
				") teamColor=" + std::to_string(ae.teamColor) + " chars=" + std::to_string(characters.size()));

			// Match anchor to nearest character by proximity
			float bestDist = 1e9f;
			int bestChar = -1;
			for (size_t ci = 0; ci < characters.size(); ++ci)
			{
				float dx = ae.pos.x - characters[ci].headPos.x;
				float dy = ae.pos.y - characters[ci].headPos.y;
				float dz = ae.pos.z - characters[ci].headPos.z;
				float d2 = dx*dx + dy*dy + dz*dz;
				if (d2 < bestDist) { bestDist = d2; bestChar = (int)ci; }
			}
			
			PFDiag::Write("[PFDIAG] Match: bestChar=" + std::to_string(bestChar) + " dist=" + std::to_string((int)sqrtf(bestDist)) + " chars=" + std::to_string(characters.size()));
			
			// Increased threshold: 30 studs squared = 900 (gun to head can be 15-20 studs)
			if (bestChar >= 0 && bestDist < 30.f * 30.f)
			{
				auto& ce = characters[bestChar];
				p.Character = ce.model;
				p.Head = ce.model.FindFirstChild("Head");
				p.HumanoidRootPart = ce.model.FindFirstChild("HumanoidRootPart");
				p.Humanoid = ce.model.FindFirstChildWhichIsA("Humanoid");
				p.RigType = 1;
				
				auto findPart = [&](const RobloxInstance& parent, const std::initializer_list<const char*>& names) -> RobloxInstance
				{
					for (const char* name : names)
					{
						RobloxInstance part = parent.FindFirstChild(name);
						if (part.address) return part;
					}
					return RobloxInstance(0);
				};
				
				p.Upper_Torso = findPart(ce.model, {"UpperTorso", "Upper Torso"});
				p.Lower_Torso = findPart(ce.model, {"LowerTorso", "Lower Torso"});
				p.Right_Upper_Arm = findPart(ce.model, {"RightUpperArm", "Right Upper Arm"});
				p.Right_Lower_Arm = findPart(ce.model, {"RightLowerArm", "Right Lower Arm"});
				p.Right_Hand = findPart(ce.model, {"RightHand", "Right Hand"});
				p.Left_Upper_Arm = findPart(ce.model, {"LeftUpperArm", "Left Upper Arm"});
				p.Left_Lower_Arm = findPart(ce.model, {"LeftLowerArm", "Left Lower Arm"});
				p.Left_Hand = findPart(ce.model, {"LeftHand", "Left Hand"});
				p.Right_Upper_Leg = findPart(ce.model, {"RightUpperLeg", "Right Upper Leg"});
				p.Right_Lower_Leg = findPart(ce.model, {"RightLowerLeg", "Right Lower Leg"});
				p.Right_Foot = findPart(ce.model, {"RightFoot", "Right Foot"});
				p.Left_Upper_Leg = findPart(ce.model, {"LeftUpperLeg", "Left Upper Leg"});
				p.Left_Lower_Leg = findPart(ce.model, {"LeftLowerLeg", "Left Lower Leg"});
				p.Left_Foot = findPart(ce.model, {"LeftFoot", "Left Foot"});
			}
			if (p.HumanoidRootPart.address == 0)
				p.HumanoidRootPart = p.Head;

			// TeamCheck: use actual TeamColor from Player object (stored in ae.teamColor)
			p.TeamColor = ae.teamColor;
			tempList.push_back(p);
		}

		{
				std::lock_guard<std::mutex> lock(Globals::Caches::CachedPlayerObjectsMutex);
				Globals::Caches::CachedPlayerObjects = std::move(tempList);
			}

			// 100ms = 10Hz cache update (reduces CPU load significantly)
			// Player positions don't change fast enough to need 25Hz
			std::this_thread::sleep_for(std::chrono::milliseconds(100));
			continue;
		}

		for (auto& player : Globals::Caches::CachedPlayers)
		{
			RobloxPlayer p;

			if (!player || player.address == 0)
				continue;

			p.address = player.address;

			// Check if this is a Player object or a Model (NPC)
			std::string className = player.Class();
			bool isNPC = (className == "Model");

			if (isNPC)
			{
				// For NPCs (models), the object IS the character
				p.Name = player.Name();
				p.Team = RobloxInstance(0);
				p.TeamColor = 0;
				p.TeamBrickColor = 0;
				p.TeamName = "";
				p.Character = player;
				p.Humanoid = p.Character.FindFirstChildWhichIsA("Humanoid");
				if (!p.Humanoid.address)
					continue;
				p.Health = Memory->read<float>(p.Humanoid.address + Offsets::Humanoid::Health);
				p.MaxHealth = Memory->read<float>(p.Humanoid.address + Offsets::Humanoid::MaxHealth);
			}
else
				{
					// For real players
					p.Name = player.Name();
					p.Team = player.Team();
					p.TeamColor = Memory->read<int>(player.address + Offsets::Player::TeamColor);
					if (p.Team.address != 0)
					{
						p.TeamName = p.Team.Name();
						if (Globals::Roblox::isRivals && p.TeamName.empty())
						{
							// Rivals strips the Team object for non-local players (Team()
							// comes back empty/0), so TeamBrickColor was never populated
							// and every Rivals player was reading as "no team" == enemy.
							// Rivals keeps the real affiliation on the player's own
							// TeamColor offset, so fall back to that here.
							p.TeamBrickColor = p.TeamColor & 0xFFFF;
						}
						else
						{
							p.TeamBrickColor = Memory->read<int>(p.Team.address + Offsets::Team::BrickColor);
						}
					}
					else
					{
						p.TeamName = "";
						// Rivals: Team object stripped, use TeamColor from player offset
						if (Globals::Roblox::isRivals)
							p.TeamBrickColor = p.TeamColor & 0xFFFF;
						else
							p.TeamBrickColor = 0;
					}
				p.Character = player.Character();
				if (!p.Character.address)
					continue;
				p.Humanoid = p.Character.FindFirstChildWhichIsA("Humanoid");
				if (!p.Humanoid.address)
					continue;
				p.Health = player.Health();
				p.MaxHealth = player.MaxHealth();

				// ── Rivals progression ──
				// CustomLeaderstats, NOT "leaderstats". Rank is not a name either:
				// it is an ELO number under "Current ELO", and the tier comes from
				// a threshold ladder. Both values are int64 at Misc::Value.
				//
				// Gated on the toggles: this is a per-player scan on top of an
				// already busy cache rebuild, and there is no reason to pay for it
				// when neither Rank nor Level is switched on. Reads are cached per
				// player and reused when a read misses, because CustomLeaderstats
				// is not reliably resident and level would otherwise flicker.
				p.Level = -1;
				p.Elo = -1;
				p.LevelResolved = false;
				p.RankResolved = false;
				p.RankStem.clear();

				if (Options::ESP::Rank || Options::ESP::Level)
				{
					// Two bulk scans total: the Player's children to locate
					// CustomLeaderstats, then that folder's children picking up
					// both Level and Current ELO in a single pass.
					const auto siblings = player.GetChildrenBulk();
					const RobloxInstance stats = player.FindInChildren(siblings, "CustomLeaderstats");

					if (stats.address)
					{
						const auto stats_children = stats.GetChildrenBulk();

						if (const RobloxInstance lvl = stats.FindInChildren(stats_children, "Level"))
						{
							std::int64_t v = 0;
							if (lvl.ProgressionValue(v) && v >= 0)
							{
								p.Level = v;
								p.LevelResolved = true;
							}
						}

						if (const RobloxInstance elo = stats.FindInChildren(stats_children, "Current ELO"))
						{
							std::int64_t v = -1;
							if (elo.ProgressionValue(v))
							{
								p.Elo = v;
								p.RankResolved = true;
							}
						}
					}

					if (p.RankResolved)
						p.RankStem = RankIconStem(RankFromElo(p.Elo));

					const uintptr_t id = player.address;
					auto& cached = ProgressionCache()[id];

					if (!p.LevelResolved && cached.LevelResolved)
					{
						p.Level = cached.Level;
						p.LevelResolved = true;
					}
					if (!p.RankResolved && cached.RankResolved)
					{
						p.Elo = cached.Elo;
						p.RankResolved = true;
						p.RankStem = RankIconStem(RankFromElo(p.Elo));
					}

					if (p.LevelResolved)
					{
						cached.Level = p.Level;
						cached.LevelResolved = true;
					}
					if (p.RankResolved)
					{
						cached.Elo = p.Elo;
						cached.RankResolved = true;
					}
				}
			}

			p.RigType = p.Humanoid.RigType();

			p.Head = p.Character.FindFirstChild("Head");
			p.HumanoidRootPart = p.Character.FindFirstChild("HumanoidRootPart");

			if (p.HumanoidRootPart.address)
			{
				uintptr_t primitiveAddr = Memory->read<uintptr_t>(p.HumanoidRootPart.address + Offsets::BasePart::Primitive);
				if (primitiveAddr)
					p.Velocity = Memory->read<Vectors::Vector3>(primitiveAddr + Offsets::Primitive::AssemblyLinearVelocity);
			}

			// Cache equipped tool name. In modern/Rivals games the weapon is a
			// Tool that lives in the player's Backpack (child of the Player), and
			// may be nested inside folders, so we scan the character a couple
			// levels deep and fall back to the Backpack.
			p.ToolName = "";
			if (p.Character.address)
				p.ToolName = FindToolName(p.Character, 0);

			if (p.ToolName.empty())
			{
				auto backpack = player.FindFirstChild("Backpack");
				if (backpack.address)
					p.ToolName = FindToolName(backpack, 0);
			}

			// Rivals keeps every player's currently equipped weapon in
			// Workspace > ViewModels as "<Name> - <Weapon> - <Weapon>" models,
			// visible even in the lobby/hub. Use it as ground truth whenever the
			// character/backpack scan came up empty (the prefix match makes it
			// Rivals-specific, so it is safe to run regardless of place-ID).
			if (p.ToolName.empty() && Globals::Roblox::Workspace.address)
			{
				auto vm = Globals::Roblox::Workspace.FindFirstChild("ViewModels");
				if (vm.address)
				{
					std::string prefix = p.Name + " - ";
					for (auto& c : vm.GetChildren())
					{
						std::string nm = c.Name();
						if (nm.size() > prefix.size() && nm.compare(0, prefix.size(), prefix) == 0)
						{
							std::string rest = nm.substr(prefix.size());
							size_t sep = rest.find(" - ");
							p.ToolName = (sep != std::string::npos) ? rest.substr(0, sep) : rest;
							break;
						}
					}
				}
			}

			switch (p.RigType)
			{
			case 0: // R6
				p.Left_Arm = p.Character.FindFirstChild("Left Arm");
				p.Left_Leg = p.Character.FindFirstChild("Left Leg");

				p.Right_Arm = p.Character.FindFirstChild("Right Arm");
				p.Right_Leg = p.Character.FindFirstChild("Right Leg");

				p.Torso = p.Character.FindFirstChild("Torso");

				break;
			case 1: // R15
				p.Upper_Torso = p.Character.FindFirstChild("UpperTorso");
				p.Lower_Torso = p.Character.FindFirstChild("LowerTorso");

				p.Right_Upper_Arm = p.Character.FindFirstChild("RightUpperArm");
				p.Right_Lower_Arm = p.Character.FindFirstChild("RightLowerArm");
				p.Right_Hand = p.Character.FindFirstChild("RightHand");

				p.Left_Upper_Arm = p.Character.FindFirstChild("LeftUpperArm");
				p.Left_Lower_Arm = p.Character.FindFirstChild("LeftLowerArm");
				p.Left_Hand = p.Character.FindFirstChild("LeftHand");

				p.Right_Upper_Leg = p.Character.FindFirstChild("RightUpperLeg");
				p.Right_Lower_Leg = p.Character.FindFirstChild("RightLowerLeg");
				p.Right_Foot = p.Character.FindFirstChild("RightFoot");

				p.Left_Upper_Leg = p.Character.FindFirstChild("LeftUpperLeg");
				p.Left_Lower_Leg = p.Character.FindFirstChild("LeftLowerLeg");
				p.Left_Foot = p.Character.FindFirstChild("LeftFoot");

				break;
			default:
				break;
			}

			tempList.push_back(p);
		}

		{
			std::lock_guard<std::mutex> lock(Globals::Caches::CachedPlayerObjectsMutex);
			Globals::Caches::CachedPlayerObjects = std::move(tempList);
		}

		if (Globals::Roblox::LocalPlayer.address != 0)
		{
			Globals::Roblox::LocalPlayerTeam = Globals::Roblox::LocalPlayer.Team();
			Globals::Roblox::LocalPlayerTeamColor = Memory->read<int>(Globals::Roblox::LocalPlayer.address + Offsets::Player::TeamColor);
			
			if (Globals::Roblox::LocalPlayerTeam.address != 0)
			{
				Globals::Roblox::LocalPlayerTeamName = Globals::Roblox::LocalPlayerTeam.Name();
				Globals::Roblox::LocalPlayerTeamBrickColor = Memory->read<int>(Globals::Roblox::LocalPlayerTeam.address + Offsets::Team::BrickColor);
			}
			else
			{
				Globals::Roblox::LocalPlayerTeamName = "";
				// Rivals: Team object is stripped for local player too, fall back to TeamColor offset
				if (Globals::Roblox::isRivals)
				{
					Globals::Roblox::LocalPlayerTeamBrickColor = Globals::Roblox::LocalPlayerTeamColor & 0xFFFF;
				}
				else
				{
					Globals::Roblox::LocalPlayerTeamBrickColor = 0;
				}
			}
		}

		// Sleep in small increments to allow instant response to forceRefresh
		for (int i = 0; i < 5 && Globals::running; i++)
		{
			if (Globals::Caches::forceRefresh)
				break;
			std::this_thread::sleep_for(std::chrono::milliseconds(100));
		}
	}
}